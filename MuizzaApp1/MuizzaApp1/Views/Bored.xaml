                        Source="back_arrow.png"
                        HeightRequest="24"
                        WidthRequest="24"
                        HorizontalOptions="Start"
                        Clicked="OnBackButtonClicked"/>

            <!-- Title -->
            <Label Grid.Column="1"
                   Text="Bored"
                   FontFamily="fredoka"
                   FontSize="24"
                   TextColor="#4A3831"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Margin="0,0,20,0"/>
        </Grid>

