<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MuizzaApp1.Views.NotesPage"
             x:Name="root"
             BackgroundColor="#f6e5cb">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Grid Grid.Row="0" 
              Padding="20,0"
              Margin="0,10"
              ColumnDefinitions="*,Auto">
            <Button Text="Notes" 
                    FontSize="24"
                    TextColor="#4a3831"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Start"
                    Padding="0"
                    Clicked="OnNotesClicked"/>
            <Button Grid.Column="1" 
                    Text="Done"
                    FontSize="24"
                    BackgroundColor="Transparent"
                    TextColor="#4a3831"
                    Clicked="OnDoneClicked"
                    Pressed="OnDonePressed">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding Source={x:Reference root}, Path=BindingContext.IsSaving}"
                                 Value="True">
                        <Setter Property="IsEnabled" Value="False"/>
                        <Setter Property="Opacity" Value="0.5"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <!-- Divider -->
        <BoxView Grid.Row="0"
                 HeightRequest="4"
                 Color="Black"
                 HorizontalOptions="Fill"
                 VerticalOptions="End"
                 Margin="0,5"/>

        <Image Grid.Row="1"
               Source="cat_note.png"
               HeightRequest="79"
               VerticalOptions="Start"
               Margin="0,-86,0,0"
               ZIndex="1"
               HorizontalOptions="Center" />

        <!-- Content -->
        <ScrollView Grid.Row="1" 
                   Margin="0,0,0,20">
            <VerticalStackLayout Padding="20,10">
                <Label Text="What's on your mind?"
                       FontSize="25"
                       TextColor="#4a3831"
                       Margin="55,20,0,10"/>
                <Editor x:Name="editor"
                        BackgroundColor="Transparent"
                        TextColor="#4a3831"
                        AutoSize="TextChanges"
                        FontSize="18"
                        FontFamily="etna"
                        Placeholder="Start writing here..."
                        PlaceholderColor="Grey"
                        Margin="15,0,0,0"
                        TextChanged="OnEditorTextChanged"/>
            </VerticalStackLayout>
        </ScrollView>
        
        
        <!-- Navigation Bar -->
        <Grid Grid.Row="2"
              x:Name="NavigationBar">
            <Grid.Margin>
                <OnPlatform x:TypeArguments="Thickness">
                    <On Platform="iOS" Value="0,-10,0,-30"/>
                    <On Platform="Android" Value="0,60,0,-60"/>
                </OnPlatform>
            </Grid.Margin>

            <!-- Main Navigation Frame -->
            <Frame CornerRadius="33" 
                   Margin="-10" 
                   BackgroundColor="White" 
                   HeightRequest="130"
                   VerticalOptions="End">
                <Grid ColumnDefinitions="*,*,*">
                    <Grid.Shadow>
                        <Shadow Offset="10,10" 
                                Radius="30" 
                                Opacity="0.5"/>
                    </Grid.Shadow>
                    <ImageButton Grid.Column="0" 
                                HeightRequest="50" 
                                WidthRequest="50"
                                Margin="0,-20,0,0"
                                Source="quotes_icon"
                                Command="{Binding NavigateToQuotesPage}"/>
                    <ImageButton Grid.Column="2" 
                                HeightRequest="50" 
                                WidthRequest="40" 
                                Margin="0,-20,0,0"
                                Command="{Binding NavigateToBrainPage}" 
                                Source="meditate_icon"/>
                </Grid>
            </Frame>

            <!-- Selected Tab Indicator -->
            <Grid HeightRequest="95" 
                  WidthRequest="100"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"
                  Margin="{OnPlatform iOS='0,0,0,35', Android='0,0,0,35'}">
                <!-- Background Frame -->
                <Frame BackgroundColor="#f6e5cb"
                       CornerRadius="33"
                       IsClippedToBounds="False"
                       InputTransparent="True"/>

                <Button Command="{Binding NavigateToNotesPage}"
                        BackgroundColor="Transparent"
                        HeightRequest="95"
                        WidthRequest="100"/>
                
                <!-- Icon -->
                <Image Source="notes_icon"
                       HeightRequest="65" 
                       WidthRequest="65"
                       InputTransparent="True"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Grid>
        </Grid>

        <!-- Save Success Popup -->
        <Grid x:Name="SaveSuccessPopup"
              Grid.RowSpan="3"
              IsVisible="false"
              BackgroundColor="#80000000">
            <Frame CornerRadius="20"
                   BackgroundColor="White"
                   WidthRequest="300"
                   HeightRequest="200"
                   VerticalOptions="Center"
                   HorizontalOptions="Center">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Cat Image -->
                    <Image Grid.Row="0"
                           Source="cat_note.png"
                           HeightRequest="70"
                           HorizontalOptions="Center"
                           Margin="0,-50,0,0"/>
                           
                    <VerticalStackLayout Grid.Row="1"
                                         Spacing="10"
                                         VerticalOptions="Center">
                        <Label Text="Purrfect!"
                               FontSize="28"
                               TextColor="#4a3831"
                               FontFamily="fredoka"
                               HorizontalOptions="Center"/>
                        
                        <Label Text="Your thoughts have been saved!"
                               FontSize="18"
                               TextColor="#4a3831"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                    
                    <Button Grid.Row="2"
                            Text="Meow-velous!"
                            BackgroundColor="#f6e5cb"
                            TextColor="#4a3831"
                            WidthRequest="150"
                            HeightRequest="40"
                            CornerRadius="20"
                            HorizontalOptions="Center"
                            Clicked="OnSavePopupDismissed"/>
                </Grid>
            </Frame>
        </Grid>

        <!-- Note Limit Popup -->
        <Grid x:Name="NoteLimitPopup"
              Grid.RowSpan="3"
              IsVisible="false"
              BackgroundColor="#80000000">
            <Frame CornerRadius="20"
                   BackgroundColor="White"
                   WidthRequest="300"
                   HeightRequest="250"
                   VerticalOptions="Center"
                   HorizontalOptions="Center">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Cat Image -->
                    <Image Grid.Row="0"
                           Source="cat_note.png"
                           HeightRequest="70"
                           HorizontalOptions="Center"
                           Margin="0,-50,0,0"/>
                           
                    <VerticalStackLayout Grid.Row="1"
                                        Spacing="10"
                                        VerticalOptions="Center">
                        <Label Text="Note Limit Reached!"
                               FontSize="24"
                               TextColor="#4a3831"
                               FontFamily="fredoka"
                               HorizontalOptions="Center"/>
                        
                        <Label Text="You've reached the maximum of 20 notes. Would you like to upgrade to Premium for unlimited notes, or manage your existing notes?"
                               FontSize="16"
                               TextColor="#4a3831"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Grid.Row="2"
                                        Spacing="10"
                                        HorizontalOptions="Center">
                        <Button Text="Upgrade to Premium"
                                BackgroundColor="#f6e5cb"
                                TextColor="#4a3831"
                                WidthRequest="200"
                                HeightRequest="40"
                                CornerRadius="20"
                                Clicked="OnUpgradeClicked"/>
                        
                        <Button Text="Manage Notes"
                                BackgroundColor="#f6e5cb"
                                TextColor="#4a3831"
                                WidthRequest="200"
                                HeightRequest="40"
                                CornerRadius="20"
                                Clicked="OnManageNotesClicked"/>
                    </VerticalStackLayout>
                </Grid>
            </Frame>
        </Grid>
    </Grid>
</ContentPage> 