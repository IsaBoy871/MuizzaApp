<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MuizzaApp1.QuotesPage">

    <Grid BackgroundColor="#f6e5cb">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Status Bar Area -->
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/> <!-- Main Content -->
            <RowDefinition Height="Auto"/> <!-- Navigation Bar -->
        </Grid.RowDefinitions>

        <!-- No Wi-Fi Overlay -->
        <Grid Grid.RowSpan="4" 
              BackgroundColor="#f6e5cb"
              IsVisible="{Binding HasNoInternet}">
            <VerticalStackLayout Spacing="20" 
                               VerticalOptions="Center" 
                               HorizontalOptions="Center"
                               Margin="20">
                <!-- Sad Cat Image -->
                <Image Source="cat_sad.png"
                       HeightRequest="200"
                       WidthRequest="200"
                       HorizontalOptions="Center">
                    <Image.Shadow>
                        <Shadow Brush="#4a3831"
                               Offset="4,4"
                               Radius="8"
                               Opacity="0.2"/>
                    </Image.Shadow>
                </Image>

                <!-- Message -->
                <Label Text="Meow! No Internet Connection"
                       FontFamily="FredokaOne"
                       FontSize="24"
                       TextColor="#4a3831"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>

                <Label Text="Please check your Wi-Fi and try again"
                       FontFamily="Fredoka"
                       FontSize="18"
                       TextColor="#666666"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>

                <!-- Retry Button -->
                <Frame BackgroundColor="White"
                       CornerRadius="25"
                       HasShadow="True"
                       Padding="20,15"
                       Margin="0,20,0,0">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RetryConnectionCommand}"/>
                    </Frame.GestureRecognizers>
                    <Label Text="Try Again"
                           FontFamily="Fredoka"
                           FontSize="18"
                           TextColor="#4a3831"
                           HorizontalOptions="Center"/>
                </Frame>
            </VerticalStackLayout>
        </Grid>

        <!-- Background Images -->
        <Grid Grid.Row="2" InputTransparent="True">
            <!-- Backdrop Image -->
            <Image Source="quotes_backdrop.png"
                   InputTransparent="True"
                   SemanticProperties.Description="Quotes Background"
                   x:Name="BackdropImage"
                   Aspect="AspectFill"
                   HeightRequest="{OnPlatform iOS=570, Android=760}"
                   WidthRequest="{OnPlatform iOS=440, Android=450}"
                   VerticalOptions="Start"
                   HorizontalOptions="Center"
                   Margin="{OnPlatform iOS='0,-200,0,0', Android='0,-60,0,0'}"/>
        </Grid>

        <!-- Top Bar with Icons -->
        <Grid Grid.Row="1" 
              ColumnDefinitions="Auto,*,Auto"
              Margin="{OnPlatform iOS='20,10,20,0', Android='20,10,20,0'}">
            <ImageButton Grid.Column="0"
                        Source="subscribe_icon.png"
                        HeightRequest="30"
                        WidthRequest="30"
                        HorizontalOptions="Start"
                        BackgroundColor="Transparent"
                        Command="{Binding NavigateToSubscriptionCommand}">
                <ImageButton.Shadow>
                    <Shadow Brush="#4a3831"
                           Offset="2,2"
                           Radius="4"
                           Opacity="0.3"/>
                </ImageButton.Shadow>
            </ImageButton>

            <Image Grid.Column="1"
                   Source="muizza_title.png"
                   HeightRequest="25"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"/>

            <ImageButton Grid.Column="2"
                        Source="profile_icon.png"
                        HeightRequest="30"
                        WidthRequest="30"
                        HorizontalOptions="End"
                        BackgroundColor="Transparent"
                        Command="{Binding NavigateToProfileCommand}">
                <ImageButton.Shadow>
                    <Shadow Brush="#4a3831"
                           Offset="2,2"
                           Radius="4"
                           Opacity="0.3"/>
                </ImageButton.Shadow>
            </ImageButton>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Affirmations -->
                <RowDefinition Height="Auto"/> <!-- Search -->
                <RowDefinition Height="*"/> <!-- Emotions Grid -->
            </Grid.RowDefinitions>

            <!-- Cat Backdrop Image -->
            <Image Source="cat_quotesbackdrop.png"
                   Grid.Row="1"
                   Aspect="AspectFit"
                   HorizontalOptions="End"
                   InputTransparent="True"
                   SemanticProperties.Description="Cat Backdrop"
                   x:Name="CatBackdropImage"
                   HeightRequest="{OnPlatform iOS=105, Android=105}"
                   WidthRequest="{OnPlatform iOS=105, Android=105}"
                   VerticalOptions="Center"
                   Margin="0,-40,-20,0"
                   ZIndex="1"/>

            <!-- Affirmations Section -->
            <Grid Grid.Row="0" 
                  HeightRequest="120"
                  Margin="20,10,20,10">
                <CollectionView ItemsSource="{Binding Affirmations}"
                              HorizontalScrollBarVisibility="Never"
                              ItemsUpdatingScrollMode="KeepItemsInView"
                              Scrolled="OnCollectionViewScrolled">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal"
                                         SnapPointsType="MandatorySingle"
                                         SnapPointsAlignment="Center"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid WidthRequest="{OnPlatform iOS=350, Android=360}">
                                <Label Text="{Binding Text}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       FontSize="20"
                                       TextColor="#4a3831"
                                       LineBreakMode="WordWrap"
                                       MaxLines="3"
                                       Margin="20,0"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- Search Section -->
            <Border Grid.Row="1"
                    BackgroundColor="White"
                    StrokeThickness="3"
                    Stroke="Black"
                    StrokeShape="RoundRectangle 20"
                    Margin="20,0,20,40">
                <Grid ColumnDefinitions="Auto,*" 
                      Padding="15,5">
                    <Image Grid.Column="0"
                           Source="search_icon.png"
                           HeightRequest="20"
                           WidthRequest="20"
                           VerticalOptions="Center"/>
                    <Entry Grid.Column="1"
                           Placeholder="Pour your heart out..."
                           PlaceholderColor="Grey"
                           BackgroundColor="Transparent"
                           ClearButtonVisibility="Never"
                           HeightRequest="40"
                           TextColor="Black"
                           Margin="5,0,30,0"
                           Completed="OnFeelingEntered"
                           ReturnCommand="{Binding SubmitFeelingCommand}"
                           Text="{Binding FeelingText}"/>
                </Grid>
            </Border>

            <!-- Emotions Grid -->
            <ScrollView Grid.Row="2" 
                       Margin="20,0,20,5"
                       x:Name="EmotionsScrollView">
                <FlexLayout Wrap="Wrap"
                           JustifyContent="SpaceBetween"
                           BindableLayout.ItemsSource="{Binding EmotionsList}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid HeightRequest="{OnPlatform iOS=150, Android=160}"
                                  WidthRequest="{OnPlatform iOS=150, Android=160}"
                                  Margin="5,10">
                                <Frame BackgroundColor="{Binding Color}"
                                       CornerRadius="15"
                                       Padding="0">
                                    <Grid>
                                        <Image Source="{Binding ImageSource}"
                                               Aspect="AspectFit"
                                               HeightRequest="120"
                                               WidthRequest="120"
                                               Margin="15"
                                               VerticalOptions="Center"/>
                                        <Label Text="{Binding Name}"
                                               TextColor="White"
                                               FontSize="16"
                                               FontFamily="fredoka"
                                               HorizontalOptions="Center"
                                               VerticalOptions="End"
                                               Margin="0,0,0,10">
                                            <Label.Shadow>
                                                <Shadow Brush="Black"
                                                        Offset="1.5,1.5"
                                                        Radius="2"
                                                        Opacity="1"/>
                                            </Label.Shadow>
                                        </Label>
                                    </Grid>
                                </Frame>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateToEmotionCommand}"
                                        CommandParameter="{Binding Name}"/>
                                </Grid.GestureRecognizers>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </ScrollView>
        </Grid>

        <!-- Navigation Bar -->
        <Grid Grid.Row="3"
              x:Name="NavigationBar">
            <Grid.Margin>
                <OnPlatform x:TypeArguments="Thickness">
                    <On Platform="iOS" Value="0,-10,0,-30"/>
                    <On Platform="Android" Value="0,60,0,-60"/>
                </OnPlatform>
            </Grid.Margin>

            <!-- Main Navigation Frame -->
            <Frame CornerRadius="33" 
                   Margin="-10" 
                   BackgroundColor="White" 
                   HeightRequest="130"
                   VerticalOptions="End">
                <Grid ColumnDefinitions="*,*,*">
                    <Grid.Shadow>
                        <Shadow Offset="10,10" 
                                Radius="30" 
                                Opacity="0.5"/>
                    </Grid.Shadow>
                    <Image Grid.Column="0" 
                           HeightRequest="50" 
                           WidthRequest="50"
                           Margin="0,-20,0,0"
                           Source="quotes_icon"/>
                    <ImageButton Grid.Column="2" 
                                HeightRequest="50" 
                                WidthRequest="40" 
                                Margin="0,-20,0,0"
                                Command="{Binding NavigateToBrainPage}" 
                                Source="meditate_icon"/>
                </Grid>
            </Frame>

            <!-- Selected Tab Indicator -->
            <Grid HeightRequest="95" 
                  WidthRequest="100"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"
                  Margin="{OnPlatform iOS='0,0,0,35', Android='0,0,0,35'}">
                <!-- Background Frame -->
                <Frame BackgroundColor="#f6e5cb"
                       CornerRadius="33"
                       IsClippedToBounds="False"
                       InputTransparent="True"/>

                <Button Command="{Binding NavigateToNotesPage}"
                        BackgroundColor="Transparent"
                        HeightRequest="95"
                        WidthRequest="100"/>
                
                <!-- Icon -->
                <Image Source="notes_icon"
                       HeightRequest="65" 
                       WidthRequest="65"
                       InputTransparent="True"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
