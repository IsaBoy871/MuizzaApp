<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MuizzaApp1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MuizzaApp1"
    Shell.NavBarIsVisible="False">

    <ShellContent
        Title="Main"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Quotes"
        ContentTemplate="{DataTemplate local:QuotesPage}"
        Route="QuotesPage" />

    <!-- Add other shell content items as needed -->

</Shell>